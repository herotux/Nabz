pkgname=nabz-tauri
pkgver=0.1.0
pkgrel=1
pkgdesc='Persian RTL shop accounting application'
arch=('x86_64')
url='https://github.com/herotux/Nabz'
license=('custom')
depends=('webkit2gtk-4.1' 'gtk3' 'openssl')
options=(!strip)

package() {
  install -Dm755 "$startdir/nabz-tauri" "$pkgdir/usr/bin/nabz"
  install -Dm644 "$startdir/nabz.desktop" "$pkgdir/usr/share/applications/nabz.desktop"
  install -Dm644 "$startdir/nabz.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/nabz.png"
}
