# Maintainer: Hamid Saidy <herotux@users.noreply.github.com>
pkgname=nabz-tauri
pkgver=0.1.0.r1.g0000000
pkgrel=1
pkgdesc="Nabz web-based accounting UI packaged with Tauri"
arch=('x86_64')
url="https://github.com/herotux/Nabz"
license=('MIT')
depends=('gcc-libs' 'glibc' 'gtk3' 'libayatana-appindicator' 'librsvg' 'openssl' 'webkit2gtk-4.1')
makedepends=('git' 'rust' 'nodejs' 'npm' 'pkgconf' 'base-devel')
provides=('nabz-tauri')
conflicts=('nabz-tauri-git')
source=("nabz::git+https://github.com/herotux/Nabz.git#branch=feature/shared-core-ui-switching")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/nabz"
  local version count revision
  version="$(node -p 'require("./tauri-web/package.json").version')"
  count="$(git rev-list --count HEAD)"
  revision="$(git rev-parse --short=7 HEAD)"
  printf '%s.r%s.g%s' "${version//-/_}" "$count" "$revision"
}

prepare() {
  cd "$srcdir/nabz/tauri-web"
  npm install --no-audit --no-fund
}

build() {
  cd "$srcdir/nabz/tauri-web"
  npm run build
  cargo build --release --manifest-path src-tauri/Cargo.toml
}

check() {
  cd "$srcdir/nabz"
  cargo test --manifest-path crates/nabz-core/Cargo.toml
  cargo test --manifest-path tauri-web/src-tauri/Cargo.toml --lib
}

package() {
  cd "$srcdir/nabz"
  install -Dm755 tauri-web/src-tauri/target/release/nabz-tauri "$pkgdir/usr/bin/nabz-tauri"
  install -Dm644 packaging/arch/nabz-tauri.desktop "$pkgdir/usr/share/applications/nabz-tauri.desktop"
  install -Dm644 tauri-web/src-tauri/icons/icon.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/nabz-tauri.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
