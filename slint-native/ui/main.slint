import { LineEdit, ListView, TextEdit } from "std-widgets.slint";

export struct ContactRow { id: int, name: string, kind: string, phone: string, balance: string }
export struct ProductRow { id: int, name: string, code: string, quantity: string, price: string, stock: string }
export struct InvoiceRow { id: int, label: string, kind: string, total: string, status: string, date: string }
export struct PaymentRow { id: int, label: string, kind: string, amount: string, method: string, date: string }

component AppButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <color> button-background: #f7faf9;
    in property <color> button-foreground: #29443d;
    in property <color> button-border: #d8e5df;
    callback clicked();
    background: root.enabled ? button-background : #eef1f0;
    border-color: button-border;
    border-width: 1px;
    border-radius: 8px;
    min-height: 40px;
    opacity: root.enabled ? 1 : 0.55;
    Text {
        text: root.text;
        color: root.enabled ? root.button-foreground : #84918c;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component SummaryCard inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <color> accent;
    background: #ffffff;
    border-color: #e3ebe7;
    border-width: 1px;
    border-radius: 14px;
    min-height: 122px;
    HorizontalLayout {
        spacing: 0px;
        Rectangle { width: 4px; background: accent; }
        VerticalLayout {
            padding: 18px;
            spacing: 12px;
            Text { text: title; color: #71817b; font-size: 13px; horizontal-alignment: right; }
            Text { text: value; color: #1d332c; font-size: 23px; font-weight: 700; horizontal-alignment: right; }
            Rectangle { height: 1px; background: #f0f3f1; }
            Text { text: "بر اساس اطلاعات ثبت‌شده"; color: #98a6a0; font-size: 10px; horizontal-alignment: right; }
        }
    }
}

export component MainWindow inherits Window {
    title: "نبض | حسابداری فروشگاهی";
    width: 1280px;
    height: 820px;
    background: #f3f6f5;

    in-out property <string> active-page: "داشبورد";
    in-out property <string> status-message: "آماده";
    in-out property <string> sales-today: "۰ تومان";
    in-out property <string> receipts-today: "۰ تومان";
    in-out property <string> customer-balance: "۰ تومان";
    in-out property <string> inventory-value: "۰ تومان";
    in-out property <int> contacts-count: 0;
    in-out property <int> products-count: 0;
    in-out property <int> invoices-count: 0;
    in-out property <[ContactRow]> contacts: [];
    in-out property <[ProductRow]> products: [];
    in-out property <[InvoiceRow]> invoices: [];
    in-out property <[PaymentRow]> payments: [];
    in-out property <string> contact-search: "";
    in-out property <string> product-search: "";
    in-out property <string> payment-search: "";

    in-out property <int> edit-contact-id: 0;
    in-out property <int> edit-product-id: 0;
    in-out property <string> contact-name: "";
    in-out property <string> contact-kind: "customer";
    in-out property <string> contact-phone: "";
    in-out property <string> contact-balance: "0";
    in-out property <string> contact-notes: "";

    in-out property <string> product-name: "";
    in-out property <string> product-code: "";
    in-out property <string> product-barcode: "";
    in-out property <string> product-quantity: "0";
    in-out property <string> product-buy-price: "0";
    in-out property <string> product-sell-price: "0";
    in-out property <string> product-minimum: "0";
    in-out property <int> adjustment-product-id: 0;
    in-out property <string> adjustment-new-quantity: "0";
    in-out property <string> adjustment-reason: "انبارگردانی";
    in-out property <string> inventory-adjustment-history: "هنوز سابقه‌ای ثبت نشده است.";
    in-out property <string> inventory-report-summary: "گزارش انبار آماده نیست.";
    in-out property <string> inventory-report-movements: "هنوز گردش انباری ثبت نشده است.";
    in-out property <string> profit-loss-summary: "گزارش سود و زیان آماده نیست.";
    in-out property <string> expense-category: "سایر";
    in-out property <string> expense-description: "";
    in-out property <string> expense-amount: "";

    in-out property <string> invoice-kind: "sale";
    in-out property <string> invoice-search: "";
    in-out property <string> invoice-filter-kind: "همه";
    in-out property <string> invoice-contact: "";
    in-out property <string> invoice-items-text: "";
    in-out property <string> return-items-text: "";
    in-out property <string> return-refund-method: "cash";
    in-out property <int> selected-invoice-id: 0;
    in-out property <int> void-confirmation-id: 0;
    in-out property <string> void-confirmation-message: "";
    in-out property <string> invoice-detail: "";
    in-out property <string> invoice-discount: "0";
    in-out property <string> invoice-paid: "0";
    in-out property <string> invoice-method: "cash";
    in-out property <string> invoice-notes: "";

    in-out property <string> payment-kind: "receipt";
    in-out property <string> payment-contact: "";
    in-out property <string> payment-amount: "";
    in-out property <string> payment-method: "cash";
    in-out property <string> payment-notes: "";

    in-out property <string> settings-store-name: "فروشگاه من";
    in-out property <string> settings-currency: "تومان";
    in-out property <bool> restore-confirmation: false;

    callback refresh-requested();
    callback save-contact-requested();
    callback edit-contact-requested(int);
    callback edit-product-requested(int);
    callback save-product-requested();
    callback adjust-inventory-requested(int);
    callback save-inventory-adjustment-requested();
    callback save-invoice-requested();
    callback invoice-detail-requested(int);
    callback invoice-void-requested(int);
    callback invoice-return-requested(int, string, string);
    callback save-payment-requested();
    callback save-expense-requested();
    callback save-settings-requested();
    callback switch-ui-requested();
    callback create-backup-requested();
    callback restore-backup-requested();

    VerticalLayout {
        spacing: 0px;
        Rectangle {
            background: #ffffff;
            height: 76px;
            border-color: #e3ebe7;
            border-width: 1px;
            HorizontalLayout {
                padding-left: 28px; padding-right: 28px;
                alignment: center; spacing: 14px;
                Rectangle { width: 40px; height: 40px; border-radius: 12px; background: #e8f5ee; Text { text: "ن"; color: #138354; font-size: 24px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; } }\n                Text { text: "نبض"; color: #176b4b; font-size: 25px; font-weight: 800; }
                VerticalLayout { spacing: 2px; horizontal-stretch: 1; Text { text: "حسابداری فروشگاهی"; color: #263c34; font-size: 15px; font-weight: 600; horizontal-alignment: right; } Text { text: "مدیریت هوشمند فروشگاه"; color: #98a6a0; font-size: 10px; horizontal-alignment: right; } }
                AppAppButton { text: "رابط Tauri"; clicked => { root.switch-ui-requested(); } }
                AppButton { text: "تازه‌سازی"; clicked => { root.refresh-requested(); } }
            }
        }
        HorizontalLayout {
            spacing: 0px;
            Rectangle {
                background: #f4f6f8; horizontal-stretch: 1;
                VerticalLayout {
                    padding: 26px; spacing: 18px;
                    Text { text: root.active-page; color: #20372f; font-size: 26px; font-weight: 800; horizontal-alignment: right; }

                    if root.active-page == "داشبورد": VerticalLayout {
                        spacing: 14px;
                        Text { text: "خلاصهٔ وضعیت فروشگاه"; color: #71817b; font-size: 14px; horizontal-alignment: right; }
                        HorizontalLayout {
                            spacing: 12px;
                            SummaryCard { title: "فروش امروز"; value: root.sales-today; accent: #138354; }
                            SummaryCard { title: "دریافت امروز"; value: root.receipts-today; accent: #2876c7; }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            SummaryCard { title: "ماندهٔ مشتریان"; value: root.customer-balance; accent: #c47a16; }
                            SummaryCard { title: "ارزش موجودی"; value: root.inventory-value; accent: #6941c6; }
                        }
                        Rectangle {
                            background: #ffffff; border-color: #e3ebe7; border-width: 1px; border-radius: 14px;
                            VerticalLayout {
                                spacing: 8px;
                                Text { text: "اطلاعات پایگاه داده"; color: #20372f; font-size: 17px; font-weight: 600; horizontal-alignment: right; }
                                Text { text: "طرف‌حساب: " + root.contacts-count + "    کالا: " + root.products-count + "    فاکتور: " + root.invoices-count; color: #53675f; font-size: 15px; horizontal-alignment: right; }
                                Text { text: "داده‌ها از SQLite محلی خوانده می‌شوند؛ این رابط بومی است و مرورگر داخلی ندارد."; color: #71817b; font-size: 13px; wrap: word-wrap; horizontal-alignment: right; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 14px;
                            Rectangle {
                                horizontal-stretch: 1;
                                background: #ffffff; border-color: #e3ebe7; border-width: 1px; border-radius: 12px;
                                VerticalLayout {
                                    padding: 16px; spacing: 10px;
                                    Text { text: "آخرین فاکتورها"; color: #20372f; font-size: 17px; font-weight: 600; horizontal-alignment: right; }
                                    ListView {
                                        for row in root.invoices: Rectangle {
                                            height: 44px; background: #ffffff;
                                            HorizontalLayout {
                                                padding: 6px; alignment: center; spacing: 8px;
                                                Text { text: row.label; horizontal-stretch: 1; horizontal-alignment: right; color: #344c43; }
                                                Text { text: row.total; color: #138354; horizontal-alignment: right; }
                                                Text { text: row.status; color: #71817b; horizontal-alignment: right; }
                                            }
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                width: 250px;
                                background: #ffffff; border-color: #e3ebe7; border-width: 1px; border-radius: 12px;
                                VerticalLayout {
                                    padding: 16px; spacing: 10px;
                                    Text { text: "دسترسی سریع"; color: #20372f; font-size: 17px; font-weight: 600; horizontal-alignment: right; }
                                    AppButton { text: "ثبت فاکتور جدید"; clicked => { root.active-page = "فاکتورها"; } }
                                    AppButton { text: "افزودن کالا"; clicked => { root.active-page = "کالا و انبار"; } }
                                    AppButton { text: "ثبت طرف‌حساب"; button-background: #138354; button-foreground: #ffffff; button-border: #138354; clicked => { root.active-page = "طرف‌حساب‌ها"; } }
                                    AppButton { text: "ثبت دریافت یا پرداخت"; clicked => { root.active-page = "دریافت و پرداخت"; } }
                                }
                            }
                        }
                    }

                    if root.active-page == "طرف‌حساب‌ها": VerticalLayout {
                        spacing: 10px;
                        Rectangle {
                            background: #ffffff; border-color: #e3ebe7; border-width: 1px; border-radius: 12px;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;
                                Text { text: "ثبت طرف‌حساب"; color: #20372f; font-size: 16px; font-weight: 600; horizontal-alignment: right; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit { text <=> root.contact-name; placeholder-text: "نام طرف‌حساب"; }
                                    LineEdit { text <=> root.contact-phone; placeholder-text: "تلفن"; }
                                    LineEdit { text <=> root.contact-balance; placeholder-text: "ماندهٔ اولیه"; }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    AppButton { text: "مشتری"; clicked => { root.contact-kind = "customer"; } }
                                    AppButton { text: "تأمین‌کننده"; clicked => { root.contact-kind = "supplier"; } }
                                    AppButton { text: "هر دو"; clicked => { root.contact-kind = "both"; } }
                                    Text { text: "نوع انتخاب‌شده: " + root.contact-kind; color: #71817b; horizontal-stretch: 1; horizontal-alignment: right; }
                                    AppButton { text: root.edit-contact-id > 0 ? "ذخیرهٔ ویرایش" : "ثبت طرف‌حساب"; clicked => { root.save-contact-requested(); } } AppButton { text: "لغو ویرایش"; clicked => { root.edit-contact-id = 0; root.contact-name = ""; root.contact-phone = ""; } }
                                }
                            }
                        }
                        Rectangle {
                            background: #ffffff; border-color: #e3ebe7; border-width: 1px; border-radius: 12px;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 8px;
                                HorizontalLayout { spacing: 8px; LineEdit { text <=> root.contact-search; placeholder-text: "جست‌وجوی نام، تلفن یا نوع"; horizontal-stretch: 1; } AppButton { text: "جست‌وجو"; clicked => { root.refresh-requested(); } } AppButton { text: "پاک‌کردن"; clicked => { root.contact-search = ""; root.refresh-requested(); } } }
                                HorizontalLayout { padding: 8px; Text { text: "نام"; horizontal-stretch: 1; horizontal-alignment: right; color: #71817b; } Text { text: "نوع"; width: 100px; horizontal-alignment: right; color: #71817b; } Text { text: "تلفن"; width: 120px; horizontal-alignment: right; color: #71817b; } Text { text: "مانده"; width: 120px; horizontal-alignment: right; color: #71817b; } }
                                ListView {
                                    
                                    for row in root.contacts: Rectangle {
                                        height: 42px; background: #ffffff;
                                        HorizontalLayout {
                                            padding: 8px; alignment: center;
                                            Text { text: row.name; horizontal-stretch: 1; horizontal-alignment: right; color: #20372f; }
                                            Text { text: row.kind; width: 100px; horizontal-alignment: right; color: #53675f; }
                                            Text { text: row.phone; width: 120px; horizontal-alignment: right; color: #53675f; }
                                            Text { text: row.balance; width: 120px; horizontal-alignment: right; color: #53675f; } AppButton { text: "ویرایش"; clicked => { root.edit-contact-requested(row.id); } }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if root.active-page == "کالا و انبار": VerticalLayout {
                        spacing: 10px;
                        Rectangle {
                            background: #ffffff; border-color: #e3ebe7; border-width: 1px; border-radius: 12px;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;
                                Text { text: "ثبت کالا"; color: #20372f; font-size: 16px; font-weight: 600; horizontal-alignment: right; }
                                HorizontalLayout { spacing: 8px; LineEdit { text <=> root.product-name; placeholder-text: "نام کالا"; } LineEdit { text <=> root.product-code; placeholder-text: "کد کالا"; } LineEdit { text <=> root.product-barcode; placeholder-text: "بارکد"; } }
                                HorizontalLayout { spacing: 8px; LineEdit { text <=> root.product-quantity; placeholder-text: "موجودی"; } LineEdit { text <=> root.product-buy-price; placeholder-text: "قیمت خرید"; } LineEdit { text <=> root.product-sell-price; placeholder-text: "قیمت فروش"; } LineEdit { text <=> root.product-minimum; placeholder-text: "حداقل موجودی"; } AppButton { text: root.edit-product-id > 0 ? "ذخیرهٔ ویرایش" : "ثبت کالا"; clicked => { root.save-product-requested(); } } AppButton { text: "لغو ویرایش"; clicked => { root.edit-product-id = 0; root.product-name = ""; root.product-code = ""; root.product-barcode = ""; root.product-quantity = "0"; root.product-buy-price = "0"; root.product-sell-price = "0"; root.product-minimum = "0"; } } }
                            }
                        }
                        Rectangle {
                            background: #ffffff; border-color: #e3ebe7; border-width: 1px; border-radius: 14px;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;
                                Text { text: "اصلاح موجودی انبار"; color: #20372f; font-size: 15px; font-weight: 600; horizontal-alignment: right; }
                                HorizontalLayout { spacing: 8px;
                                    LineEdit { text <=> root.adjustment-new-quantity; placeholder-text: "موجودی واقعی جدید"; }
                                    LineEdit { text <=> root.adjustment-reason; placeholder-text: "علت تغییر (مثلاً انبارگردانی)"; horizontal-stretch: 1; }
                                    AppButton { text: "ثبت اصلاح موجودی"; enabled: root.adjustment-product-id > 0; clicked => { root.save-inventory-adjustment-requested(); } }
                                }
                                Text { text: "موجودی قبل و بعد، اختلاف و علت تغییر به‌صورت دائمی در سابقه ثبت می‌شود."; color: #71817b; font-size: 12px; horizontal-alignment: right; }
                                Text { text: root.inventory-adjustment-history; color: #53675f; font-size: 12px; horizontal-alignment: right; wrap: word-wrap; }
                            }
                        }
                        Rectangle {
                            background: #ffffff; border-color: #e3ebe7; border-width: 1px; border-radius: 12px;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 8px;
                                HorizontalLayout { spacing: 8px; LineEdit { text <=> root.product-search; placeholder-text: "جست‌وجوی نام، کد یا بارکد"; horizontal-stretch: 1; } AppButton { text: "جست‌وجو"; clicked => { root.refresh-requested(); } } AppButton { text: "پاک‌کردن"; clicked => { root.product-search = ""; root.refresh-requested(); } } }
                                HorizontalLayout { padding: 8px; Text { text: "نام کالا"; horizontal-stretch: 1; horizontal-alignment: right; color: #71817b; } Text { text: "کد"; width: 110px; horizontal-alignment: right; color: #71817b; } Text { text: "موجودی"; width: 90px; horizontal-alignment: right; color: #71817b; } Text { text: "قیمت فروش"; width: 130px; horizontal-alignment: right; color: #71817b; } }
                                ListView {
                                    
                                    for row in root.products: Rectangle {
                                        height: 42px; background: #ffffff;
                                        HorizontalLayout { padding: 8px; alignment: center;
                                            Text { text: row.name; horizontal-stretch: 1; horizontal-alignment: right; color: #20372f; }
                                            Text { text: row.code; width: 110px; horizontal-alignment: right; color: #53675f; }
                                            Text { text: row.quantity; width: 90px; horizontal-alignment: right; color: #53675f; }
                                            Text { text: row.price; width: 130px; horizontal-alignment: right; color: #53675f; } AppButton { text: "ویرایش"; clicked => { root.edit-product-requested(row.id); } } AppButton { text: "اصلاح موجودی"; clicked => { root.adjustment-product-id = row.id; root.adjust-inventory-requested(row.id); } }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if root.active-page == "فاکتورها": VerticalLayout {
                        spacing: 10px;
                        Rectangle {
                            background: #ffffff; border-color: #e3ebe7; border-width: 1px; border-radius: 12px;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;
                                Text { text: "ثبت فاکتور"; color: #20372f; font-size: 16px; font-weight: 600; horizontal-alignment: right; }
                                HorizontalLayout { spacing: 8px; AppButton { text: "فروش"; clicked => { root.invoice-kind = "sale"; } } AppButton { text: "خرید"; clicked => { root.invoice-kind = "purchase"; } } Text { text: "نوع: " + root.invoice-kind; horizontal-stretch: 1; horizontal-alignment: right; color: #71817b; } }
                                HorizontalLayout { spacing: 8px; LineEdit { text <=> root.invoice-contact; placeholder-text: "نام مشتری یا تأمین‌کننده"; } LineEdit { text <=> root.invoice-discount; placeholder-text: "تخفیف کل فاکتور"; } LineEdit { text <=> root.invoice-paid; placeholder-text: "مبلغ دریافتی (فروش)"; } LineEdit { text <=> root.invoice-method; placeholder-text: "روش پرداخت"; } }
                                Text { text: "هر ردیف: کد یا نام کالا | تعداد | قیمت واحد"; color: #71817b; font-size: 13px; horizontal-alignment: right; }
                                TextEdit { text <=> root.invoice-items-text; height: 150px; } 
                                HorizontalLayout { spacing: 8px; AppButton { text: "ثبت فاکتور چندردیفه"; button-background: #138354; button-foreground: #ffffff; button-border: #138354; clicked => { root.save-invoice-requested(); } } }
                            }
                        }
                        Rectangle {
                            background: #ffffff; border-color: #e3ebe7; border-width: 1px; border-radius: 14px;
                            VerticalLayout {
                                HorizontalLayout { spacing: 8px; LineEdit { text <=> root.invoice-search; placeholder-text: "جست‌وجو با شماره، طرف‌حساب یا توضیحات"; horizontal-stretch: 1; } AppButton { text: "جست‌وجو"; clicked => { root.refresh-requested(); } } }
                                HorizontalLayout { spacing: 6px; Text { text: "فیلتر:"; color: #71817b; vertical-alignment: center; } AppButton { text: "همه"; clicked => { root.invoice-filter-kind = "همه"; root.refresh-requested(); } } AppButton { text: "فروش"; clicked => { root.invoice-filter-kind = "فروش"; root.refresh-requested(); } } AppButton { text: "خرید"; clicked => { root.invoice-filter-kind = "خرید"; root.refresh-requested(); } } AppButton { text: "باطل‌شده"; clicked => { root.invoice-filter-kind = "باطل‌شده"; root.refresh-requested(); } } Text { text: "فیلتر فعال: " + root.invoice-filter-kind; horizontal-stretch: 1; horizontal-alignment: right; color: #71817b; } }
                                HorizontalLayout { padding: 8px; Text { text: "فاکتور"; horizontal-stretch: 1; horizontal-alignment: right; color: #71817b; } Text { text: "نوع"; width: 90px; horizontal-alignment: right; color: #71817b; } Text { text: "مبلغ"; width: 120px; horizontal-alignment: right; color: #71817b; } Text { text: "وضعیت"; width: 120px; horizontal-alignment: right; color: #71817b; } }
                                ListView {  for row in root.invoices: Rectangle { height: 42px; background: #ffffff; HorizontalLayout { padding: 8px; alignment: center; Text { text: row.label; horizontal-stretch: 1; horizontal-alignment: right; color: #20372f; } Text { text: row.kind; width: 90px; horizontal-alignment: right; color: #53675f; } Text { text: row.total; width: 120px; horizontal-alignment: right; color: #53675f; } Text { text: row.status; width: 120px; horizontal-alignment: right; color: #53675f; } AppButton { text: "جزئیات"; clicked => { root.selected-invoice-id = row.id; root.invoice-detail-requested(row.id); } } } } }
                                if root.invoice-detail != "": Rectangle { background: #ffffff; border-color: #e3ebe7; border-width: 1px; border-radius: 10px; VerticalLayout { spacing: 6px; Text { text: "جزئیات فاکتور انتخاب‌شده"; color: #20372f; font-size: 16px; font-weight: 600; horizontal-alignment: right; } Text { text: root.invoice-detail; color: #53675f; font-size: 13px; wrap: word-wrap; horizontal-alignment: right; } Text { text: "برگشت جزئی کالا (فقط فاکتور فروش انتخاب‌شده)"; color: #b54708; font-size: 13px; horizontal-alignment: right; }
                                TextEdit { text <=> root.return-items-text; height: 72px; }
                                Text { text: "هر ردیف: کد یا نام دقیق کالا | تعداد برگشتی"; color: #71817b; font-size: 12px; horizontal-alignment: right; }
                                HorizontalLayout { spacing: 8px; LineEdit { text <=> root.return-refund-method; placeholder-text: "روش بازپرداخت (cash / کارت / انتقال)"; horizontal-stretch: 1; } AppButton { text: "ثبت برگشت و بازپرداخت"; clicked => { root.invoice-return-requested(root.selected-invoice-id, root.return-items-text, root.return-refund-method); } } }
                                HorizontalLayout { spacing: 8px; AppButton { text: "ابطال فاکتور"; clicked => { root.void-confirmation-id = root.selected-invoice-id; root.void-confirmation-message = "برای تأیید نهایی، دکمهٔ تأیید ابطال را بزنید. این کار موجودی و دریافت اولیه را اصلاح می‌کند."; } } if root.void-confirmation-id == root.selected-invoice-id && root.void-confirmation-id > 0: AppButton { text: "تأیید ابطال"; clicked => { root.invoice-void-requested(root.selected-invoice-id); root.void-confirmation-id = 0; root.void-confirmation-message = ""; } } } if root.void-confirmation-message != "": Text { text: root.void-confirmation-message; color: #b54708; font-size: 13px; wrap: word-wrap; horizontal-alignment: right; } } }
                            }
                        }
                    }

                    if root.active-page == "دریافت و پرداخت": VerticalLayout {
                        spacing: 10px;
                        Rectangle {
                            background: #ffffff; border-color: #e3ebe7; border-width: 1px; border-radius: 12px;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;
                                Text { text: "ثبت دریافت یا پرداخت"; color: #20372f; font-size: 16px; font-weight: 600; horizontal-alignment: right; }
                                HorizontalLayout { spacing: 8px; AppButton { text: "دریافت از مشتری"; clicked => { root.payment-kind = "receipt"; } } AppButton { text: "پرداخت به تأمین‌کننده"; clicked => { root.payment-kind = "payment"; } } Text { text: "نوع: " + root.payment-kind; horizontal-stretch: 1; horizontal-alignment: right; color: #71817b; } }
                                HorizontalLayout { spacing: 8px; LineEdit { text <=> root.payment-contact; placeholder-text: "نام طرف‌حساب"; } LineEdit { text <=> root.payment-amount; placeholder-text: "مبلغ"; } LineEdit { text <=> root.payment-method; placeholder-text: "روش پرداخت"; } LineEdit { text <=> root.payment-notes; placeholder-text: "شرح"; } AppButton { text: "ثبت گردش"; button-background: #138354; button-foreground: #ffffff; button-border: #138354; clicked => { root.save-payment-requested(); } } }
                            }
                        }
                        Rectangle {
                            background: #ffffff; border-color: #e3ebe7; border-width: 1px; border-radius: 10px;
                            VerticalLayout {
                                HorizontalLayout { spacing: 8px; LineEdit { text <=> root.payment-search; placeholder-text: "جست‌وجوی طرف‌حساب، روش، شرح یا تاریخ"; horizontal-stretch: 1; } AppButton { text: "جست‌وجو"; clicked => { root.refresh-requested(); } } AppButton { text: "پاک‌کردن"; clicked => { root.payment-search = ""; root.refresh-requested(); } } }
                                HorizontalLayout { padding: 8px; Text { text: "طرف‌حساب"; horizontal-stretch: 1; horizontal-alignment: right; color: #71817b; } Text { text: "نوع"; width: 90px; horizontal-alignment: right; color: #71817b; } Text { text: "مبلغ"; width: 120px; horizontal-alignment: right; color: #71817b; } Text { text: "روش"; width: 100px; horizontal-alignment: right; color: #71817b; } }
                                ListView {  for row in root.payments: Rectangle { height: 42px; background: #ffffff; HorizontalLayout { padding: 8px; alignment: center; Text { text: row.label; horizontal-stretch: 1; horizontal-alignment: right; color: #20372f; } Text { text: row.kind; width: 90px; horizontal-alignment: right; color: #53675f; } Text { text: row.amount; width: 120px; horizontal-alignment: right; color: #53675f; } Text { text: row.method; width: 100px; horizontal-alignment: right; color: #53675f; } } } }
                            }
                        }
                    }

                    if root.active-page == "گزارش‌ها": Rectangle {
                        background: #ffffff; border-color: #e3ebe7; border-width: 1px; border-radius: 12px;
                        VerticalLayout { padding: 18px; spacing: 14px;
                            Text { text: "گزارش زنده از پایگاه داده"; color: #20372f; font-size: 18px; font-weight: 600; horizontal-alignment: right; }
                            Text { text: "فروش امروز: " + root.sales-today; color: #138354; font-size: 16px; horizontal-alignment: right; }
                            Text { text: "دریافت امروز: " + root.receipts-today; color: #2876c7; font-size: 16px; horizontal-alignment: right; }
                            Text { text: "ماندهٔ مشتریان: " + root.customer-balance; color: #c47a16; font-size: 16px; horizontal-alignment: right; }
                            Text { text: "ارزش موجودی: " + root.inventory-value; color: #6941c6; font-size: 16px; horizontal-alignment: right; }
                            Text { text: "تعداد طرف‌حساب‌ها: " + root.contacts-count + " | تعداد کالاها: " + root.products-count + " | تعداد فاکتورها: " + root.invoices-count; color: #53675f; font-size: 15px; horizontal-alignment: right; }
                            Rectangle { height: 1px; background: #e3ebe7; }
                            Text { text: "ارزش‌گذاری موجودی"; color: #20372f; font-size: 16px; font-weight: 600; horizontal-alignment: right; }
                            Text { text: root.inventory-report-summary; color: #53675f; font-size: 13px; horizontal-alignment: right; wrap: word-wrap; }
                            Text { text: "آخرین گردش‌های انبار"; color: #20372f; font-size: 16px; font-weight: 600; horizontal-alignment: right; }
                            Text { text: root.inventory-report-movements; color: #53675f; font-size: 12px; horizontal-alignment: right; wrap: word-wrap; }
                            Rectangle { height: 1px; background: #e3ebe7; }
                            Text { text: "سود و زیان"; color: #20372f; font-size: 16px; font-weight: 600; horizontal-alignment: right; }
                            Text { text: root.profit-loss-summary; color: #53675f; font-size: 13px; horizontal-alignment: right; wrap: word-wrap; }
                            Text { text: "ثبت هزینهٔ جاری"; color: #20372f; font-size: 15px; font-weight: 600; horizontal-alignment: right; }
                            LineEdit { text <=> root.expense-category; placeholder-text: "دسته‌بندی هزینه"; }
                            LineEdit { text <=> root.expense-description; placeholder-text: "شرح هزینه"; }
                            LineEdit { text <=> root.expense-amount; placeholder-text: "مبلغ به تومان"; }
                            AppButton { text: "ثبت هزینه"; button-background: #138354; button-foreground: #ffffff; button-border: #138354; clicked => { root.save-expense-requested(); } }
                        }
                    }

                    if root.active-page == "چاپ و بارکد": Rectangle {
                        background: #ffffff; border-color: #e3ebe7; border-width: 1px; border-radius: 12px;
                        VerticalLayout { padding: 18px; spacing: 14px;
                            Text { text: "چاپ و بارکد"; color: #20372f; font-size: 18px; font-weight: 600; horizontal-alignment: right; }
                            Text { text: "این بخش هنوز به موتور چاپ و تولید بارکد منتقل نشده است. چاپ مستقیم، برچسب حرارتی و قالب A4/A5 باید در مرحلهٔ بعد پیاده‌سازی و روی چاپگر واقعی آزمایش شوند."; color: #71817b; font-size: 14px; wrap: word-wrap; horizontal-alignment: right; }
                        }
                    }

                    if root.active-page == "تنظیمات": Rectangle {
                        background: #ffffff; border-color: #e3ebe7; border-width: 1px; border-radius: 12px;
                        VerticalLayout { padding: 18px; spacing: 14px;
                            Text { text: "تنظیمات فروشگاه"; color: #20372f; font-size: 18px; font-weight: 600; horizontal-alignment: right; }
                            LineEdit { text <=> root.settings-store-name; placeholder-text: "نام فروشگاه"; }
                            LineEdit { text <=> root.settings-currency; placeholder-text: "واحد پول"; }
                            AppButton { text: "ذخیرهٔ تنظیمات"; button-background: #138354; button-foreground: #ffffff; button-border: #138354; clicked => { root.save-settings-requested(); } }
                            Text { text: "تنظیمات این نسخه در SQLite ذخیره می‌شوند."; color: #71817b; font-size: 13px; horizontal-alignment: right; }
                            Rectangle { height: 1px; background: #e3ebe7; }
                            Text { text: "پشتیبان کامل پایگاه داده"; color: #20372f; font-size: 16px; font-weight: 600; horizontal-alignment: right; }
                            Text { text: "تمام جدول‌ها، فاکتورها، برگشت‌ها، پرداخت‌ها و تنظیمات در یک فایل SQLite ذخیره می‌شوند."; color: #71817b; font-size: 12px; wrap: word-wrap; horizontal-alignment: right; }
                            AppButton { text: "ساخت نسخهٔ پشتیبان"; button-background: #138354; button-foreground: #ffffff; button-border: #138354; clicked => { root.create-backup-requested(); } }
                            AppButton {
                                text: root.restore-confirmation ? "برای تأیید، دوباره کلیک کن" : "بازیابی آخرین نسخهٔ پشتیبان";
                                clicked => {
                                    if root.restore-confirmation {
                                        root.restore-confirmation = false;
                                        root.restore-backup-requested();
                                    } else {
                                        root.restore-confirmation = true;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Rectangle {
                width: 224px; background: #ffffff; border-color: #e3ebe7; border-width: 1px;
                VerticalLayout {
                    padding: 18px; spacing: 8px;
                    Text { text: "منوی اصلی"; color: #71817b; font-size: 12px; horizontal-alignment: right; }
                    AppButton { text: "داشبورد"; button-background: root.active-page == "داشبورد" ? #e8f5ee : #ffffff; button-foreground: root.active-page == "داشبورد" ? #126b49 : #52645c; button-border: root.active-page == "داشبورد" ? #c5e6d4 : #ffffff; clicked => { root.active-page = "داشبورد"; root.refresh-requested(); } }
                    AppButton { text: "طرف‌حساب‌ها"; button-background: root.active-page == "طرف‌حساب‌ها" ? #e8f5ee : #ffffff; button-foreground: root.active-page == "طرف‌حساب‌ها" ? #126b49 : #52645c; button-border: root.active-page == "طرف‌حساب‌ها" ? #c5e6d4 : #ffffff; clicked => { root.active-page = "طرف‌حساب‌ها"; root.refresh-requested(); } }
                    AppButton { text: "کالا و انبار"; button-background: root.active-page == "کالا و انبار" ? #e8f5ee : #ffffff; button-foreground: root.active-page == "کالا و انبار" ? #126b49 : #52645c; button-border: root.active-page == "کالا و انبار" ? #c5e6d4 : #ffffff; clicked => { root.active-page = "کالا و انبار"; root.refresh-requested(); } }
                    AppButton { text: "فاکتورها"; button-background: root.active-page == "فاکتورها" ? #e8f5ee : #ffffff; button-foreground: root.active-page == "فاکتورها" ? #126b49 : #52645c; button-border: root.active-page == "فاکتورها" ? #c5e6d4 : #ffffff; clicked => { root.active-page = "فاکتورها"; root.refresh-requested(); } }
                    AppButton { text: "دریافت و پرداخت"; button-background: root.active-page == "دریافت و پرداخت" ? #e8f5ee : #ffffff; button-foreground: root.active-page == "دریافت و پرداخت" ? #126b49 : #52645c; button-border: root.active-page == "دریافت و پرداخت" ? #c5e6d4 : #ffffff; clicked => { root.active-page = "دریافت و پرداخت"; root.refresh-requested(); } }
                    AppButton { text: "گزارش‌ها"; button-background: root.active-page == "گزارش‌ها" ? #e8f5ee : #ffffff; button-foreground: root.active-page == "گزارش‌ها" ? #126b49 : #52645c; button-border: root.active-page == "گزارش‌ها" ? #c5e6d4 : #ffffff; clicked => { root.active-page = "گزارش‌ها"; root.refresh-requested(); } }
                    AppButton { text: "چاپ و بارکد"; button-background: root.active-page == "چاپ و بارکد" ? #e8f5ee : #ffffff; button-foreground: root.active-page == "چاپ و بارکد" ? #126b49 : #52645c; button-border: root.active-page == "چاپ و بارکد" ? #c5e6d4 : #ffffff; clicked => { root.active-page = "چاپ و بارکد"; } }
                    AppButton { text: "تنظیمات"; button-background: root.active-page == "تنظیمات" ? #e8f5ee : #ffffff; button-foreground: root.active-page == "تنظیمات" ? #126b49 : #52645c; button-border: root.active-page == "تنظیمات" ? #c5e6d4 : #ffffff; clicked => { root.active-page = "تنظیمات"; root.refresh-requested(); } }
                    Rectangle { background: transparent; vertical-stretch: 1; }
                    Text { text: root.status-message; color: #71817b; font-size: 11px; wrap: word-wrap; horizontal-alignment: right; }
                }
            }
        }
    }
}
